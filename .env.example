# Copie para .env e preencha. O .env é local e não vai para o Git.
DB_URL=jdbc:postgresql://localhost:5432/gestao_supermercado
DB_USERNAME=gestao
DB_PASSWORD=

# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=

# Usados só na primeira subida, quando ainda não existe nenhum usuário.
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=
